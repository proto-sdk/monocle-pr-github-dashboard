{
  "name": "monocle-pr-dashboard",
  "version": "1.0.0",
  "description": "Monocle GitHub PR Dashboard - A native desktop app for monitoring GitHub PRs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "server": "node server.js",
    "dev-server": "nodemon server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "nodemon": "^3.0.1"
  },
  "build": {
    "appId": "com.block.monocle-pr-dashboard",
    "productName": "Monocle PR Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "config.js",
      "assets/**/*",
      "images/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
